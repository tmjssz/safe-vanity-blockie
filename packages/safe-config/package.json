{
  "name": "@safe-vanity-blockie/safe-config",
  "version": "0.3.0",
  "description": "Resolve canonical Safe contract addresses and build the setup inputs for counterfactual address derivation",
  "engines": { "node": ">=22" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tmjssz/safe-vanity-blockie.git",
    "directory": "packages/safe-config"
  },
  "type": "module",
  "license": "MIT",
  "keywords": ["safe", "safe-global", "create2", "counterfactual", "protocol-kit", "ethereum", "zksync"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "src", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:network": "vitest run --config vitest.network.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@safe-global/protocol-kit": "^8.0.5",
    "@safe-global/types-kit": "^4.0.1",
    "@safe-vanity-blockie/core": "workspace:*",
    "viem": "^2.55.11"
  }
}
