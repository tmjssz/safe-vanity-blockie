{
  "name": "safe-vanity-blockie",
  "version": "0.3.0",
  "engines": { "node": ">=22" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tmjssz/safe-vanity-blockie.git",
    "directory": "packages/miner"
  },
  "type": "module",
  "license": "MIT",
  "keywords": ["safe", "safe-global", "blockie", "blo", "identicon", "vanity-address", "create2", "ethereum", "cli"],
  "description": "Brute-force a Safe saltNonce so the Safe address renders a two-color face as a blo identicon",
  "bin": { "safe-vanity-blockie": "./dist/cli.js" },
  "main": "./dist/cli.js",
  "files": ["dist", "src", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:network": "vitest run --config vitest.network.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@safe-global/protocol-kit": "^8.0.5",
    "@safe-global/types-kit": "^4.0.1",
    "@safe-vanity-blockie/core": "workspace:*",
    "@safe-vanity-blockie/safe-config": "workspace:*",
    "viem": "^2.55.11"
  },
  "devDependencies": {
    "@types/node": "^24.13.3"
  }
}
