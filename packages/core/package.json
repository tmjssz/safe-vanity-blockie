{
  "name": "@safe-vanity-blockie/core",
  "version": "0.5.0",
  "description": "Isomorphic blo identicon, CREATE2 address derivation and mining primitives for Safe vanity blockies",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tmjssz/safe-vanity-blockie.git",
    "directory": "packages/core"
  },
  "type": "module",
  "license": "MIT",
  "keywords": [
    "safe",
    "safe-global",
    "blockie",
    "blo",
    "identicon",
    "vanity-address",
    "create2",
    "ethereum"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0"
  },
  "devDependencies": {
    "@noble/hashes": "^2.3.0",
    "blo": "2.0.0",
    "viem": "^2.56.0"
  }
}
